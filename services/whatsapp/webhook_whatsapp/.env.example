# WhatsApp Webhook Service Environment Variables Example
# Copy this to .env and fill in your actual values
# Do not commit .env to git

# WhatsApp Business API credentials
WA_PHONE_NUMBER_ID=your_phone_number_id_here
WA_ACCESS_TOKEN=your_access_token_here
WA_VERIFY_TOKEN=your_verify_token_here
WA_API_VERSION=v18.0
WA_API_URL=https://graph.facebook.com

# Webhook port (internal container port)
WEBHOOK_WHATSAPP_PORT=8000

# System WhatsApp Sender service URL (internal Docker network)
SYSTEM_WHATSAPP_SENDER_URL=http://whatsapp-sender:8001

# Core service URL (internal Docker network)
CORE_URL=http://core:8080

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379