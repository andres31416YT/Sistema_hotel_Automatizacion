# Payment System Service Environment Variables Example
# Copy this to .env and fill in your actual values
# Do not commit .env to git

# Mercado Pago credentials
MP_ACCESS_TOKEN=tu_access_token_de_mercadopago
MP_API_URL=https://api.mercadopago.com/v1
MP_SANDBOX=true

# DB Transaccional PostgreSQL Payments
DB_PAYMENTS_HOST=db_payments
DB_PAYMENTS_PORT=5432
DB_PAYMENTS_NAME=payments_db
DB_PAYMENTS_USER=payments_user
DB_PAYMENTS_PASSWORD=tu_password_aqui

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# System Core URL (para notificar pagos aprobados)
CORE_URL=http://core:8080
