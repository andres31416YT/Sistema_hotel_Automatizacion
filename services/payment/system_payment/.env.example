# Payment System Service Environment Variables Example
# Copy this to .env and fill in your actual values
# Do not commit .env to git

# Mercado Pago credentials
MP_ACCESS_TOKEN=your_mp_access_token_here
MP_API_URL=https://api.mercadopago.com/v1

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Core service URL (internal Docker network)
CORE_URL=http://core:8080