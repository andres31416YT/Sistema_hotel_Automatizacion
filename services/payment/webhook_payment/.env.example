# Payment Webhook Service Environment Variables Example
# Copy this to .env and fill in your actual values
# Do not commit .env to git

# Mercado Pago credentials for webhook validation
MP_WEBHOOK_SECRET=tu_webhook_secret_de_mercadopago

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# System Payment URL (para encolar notificaciones)
SYSTEM_PAYMENT_URL=http://payment-system:8003
