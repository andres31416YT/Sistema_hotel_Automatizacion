# Ngrok Tunnel for Core Webhook Environment Variables Example
# Copy this to .env and fill in your actual values
# Do not commit .env to git

# Ngrok authtoken (get from https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# Target service: core:8080 (the internal Docker service for Core API)
NGROK_TARGET=core:8080
