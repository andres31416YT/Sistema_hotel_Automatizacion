# Ngrok Tunnel for WhatsApp Webhook Environment Variables Example
# Copy this to .env and fill in your actual values
# Do not commit .env to git

# Ngrok authtoken (get from https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
# Target service: whatsapp-webhook:8000 (the internal Docker service)
NGROK_TARGET=whatsapp-webhook:8000