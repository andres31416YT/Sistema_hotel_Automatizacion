# Core Service Environment Variables Example
# Copy this to .env and fill in your actual values
# Do not commit .env to git

# Ollama configuration
OLLAMA_API_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Database connections
DB_HOTEL_HOST=db_hotel
DB_HOTEL_PORT=5432
DB_HOTEL_NAME=hotel_db
DB_HOTEL_USER=hotel_user
DB_HOTEL_PASSWORD=hotel_password

DB_PAYMENTS_HOST=db_payments
DB_PAYMENTS_PORT=5433
DB_PAYMENTS_NAME=payments_db
DB_PAYMENTS_USER=payments_user
DB_PAYMENTS_PASSWORD=payments_password

DB_RAG_HOST=db_rag
DB_RAG_PORT=5434
DB_RAG_NAME=rag_db
DB_RAG_USER=rag_user
DB_RAG_PASSWORD=rag_password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_TTL_CHAT=1800  # 30 minutes
REDIS_TTL_SESSION=3600  # 1 hour
REDIS_TTL_PROFILE=86400  # 24 hours
REDIS_TTL_PAYMENT=900  # 15 minutes
REDIS_TTL_SECURITY=3600  # 1 hour

# Service URLs
SYSTEM_WHATSAPP_SENDER_URL=http://whatsapp-sender:8001
MP_ACCESS_TOKEN=your_mp_access_token_here

# Core service port
SYSTEM_CORE_PORT=8080